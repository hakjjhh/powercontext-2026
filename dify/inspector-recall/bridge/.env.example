# PowerContext Server (trusted application-side service)
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=

# Dify HTTP Request nodes call this bridge.
# If Dify is hosted in the cloud, publish the bridge through a secure tunnel or reverse proxy.
POWERCONTEXT_BRIDGE_URL=http://127.0.0.1:8787
POWERCONTEXT_BRIDGE_TOKEN=

# Optional bridge persistence and listener
BRIDGE_DB_PATH=./state/scopes.sqlite3
BRIDGE_PORT=8787