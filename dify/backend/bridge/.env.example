# Inspector Recall - environment template (placeholders only)
#
# PowerContext Server (trusted application-side service, seekdb embedded)
POWERCONTEXT_SERVER_DATABASE_KIND=seekdb
POWERCONTEXT_SERVER_DATABASE_PATH=/data/seekdb
POWERCONTEXT_SERVER_ALLOW_UNAUTHENTICATED_NON_LOOPBACK=true
POWERCONTEXT_URL=http://powercontext:8000
POWERCONTEXT_TOKEN=

# Bridge called by the Dify HTTP Request nodes (service name inside the shared
# docker network; only override when Dify runs on another host).
POWERCONTEXT_BRIDGE_URL=http://bridge:8787
POWERCONTEXT_BRIDGE_TOKEN=

# Optional bridge persistence and listener
BRIDGE_DB_PATH=/data/scopes.sqlite3
BRIDGE_PORT=8787

# Dify admin account used by scripts/dify_setup.py (never commit real values)
DIFY_BASE_URL=http://127.0.0.1:8080
DIFY_EMAIL=admin@example.com
DIFY_PASSWORD=replace-me

# Offline model served by scripts/mock_llm.py
DIFY_MODEL=local-qwen2.5-0.5b
MODEL_BASE_URL=http://mock-llm:8099/v1
MODEL_API_KEY=dummy
